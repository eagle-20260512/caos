# CAOS 部署配置(复制为 .env 并填写;仓库零凭据,真实 key 永不入库)

# ── LLM 凭据(至少填一个;与 core/data/models.json 的 keyEnv 对应) ──
DEEPSEEK_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=

# ── 引擎 ──
CA_ORGAN_MODEL=deepseek        # 用哪个模型(models.json 条目 id)
CA_WALLET_ALLOWANCE=5.0        # CA 每日钱包额度(元;它自己的钱,烧尽=非用户令全停,翻日才续)

# ── 管理面 ──
ADMIN_TOKEN=                   # /api/admin/* 的 Bearer 令牌(留空=仅本机可调用;造物主的钥匙,含 auth-memory 复活权)
CA_VOICE_DIR=
